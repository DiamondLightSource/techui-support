        </color>
      </foreground_color>
      <background_color use_class="true">
        <color red="255" green="255" blue="255">
        </color>
      </background_color>
      <rules>
        <rule name="visibility" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0 == 0">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0 &gt;= 1">
            <value>false</value>
          </exp>
          <pv_name>$(CS):TYPE</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
