        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(CS):END.PROC</pv_name>
      <text>End (Controlled Shutdown)</text>
      <y>115</y>
      <width>205</width>
      <height>35</height>
