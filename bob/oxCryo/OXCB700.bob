  <widget type="textupdate" version="2.0.0">
    <name>Text Update_2</name>
    <pv_name>loc://gas("Gas")</pv_name>
    <x>740</x>
    <y>75</y>
    <width>135</width>
    <height>25</height>
    <rules>
      <rule name="local-pv" prop_id="pv_name" out_exp="false">
        <exp bool_exp="pvInt0 == 2">
          <value>"Sample"</value>
        </exp>
        <pv_name trigger="false">$(pv_name)</pv_name>
        <pv_name>$(P)$(Q):CSTYPE</pv_name>
      </rule>
    </rules>
  </widget>
