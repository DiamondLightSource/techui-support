    <widget type="action_button" version="3.0.0">
      <name>PURGE_Button</name>
      <class>DEFAULT_PV</class>
      <actions>
        <action type="write_pv">
          <description>Write to .PROC</description>
          <pv_name>$(pv_name).PROC</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(P)$(Q):PURGE</pv_name>
      <text>purge_text</text>
      <height>35</height>
      <font>
        <font family="Arial" style="REGULAR" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="29" green="41" blue="69">
        </color>
      </foreground_color>
      <background_color>
        <color red="255" green="255" blue="255">
        </color>
      </background_color>
      <rules>
        <rule name="change_text" prop_id="text" out_exp="true">
          <exp bool_exp="pvStr0">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>loc://purge</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
