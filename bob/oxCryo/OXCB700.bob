      <vertical_alignment use_class="true">1</vertical_alignment>
      <rules>
        <rule name="comms-text" prop_id="text" out_exp="false">
          <exp bool_exp="1 &lt;= pv0 &lt; 5">
            <value>Communication Errors</value>
          </exp>
          <exp bool_exp="pv0 &lt; 1">
            <value>Communication OK</value>
          </exp>
          <pv_name>$(CS):STATUS.SEVR</pv_name>
        </rule>
      </rules>
    </widget>
