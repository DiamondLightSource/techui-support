  <widget type="label" version="2.0.0">
    <name>TITLE</name>
    <class>TITLE</class>
    <text>Cobra Title (based on rule)</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>700</width>
    <height>40</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </background_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="change_text" prop_id="text" out_exp="true">
        <exp bool_exp="pvStr0 &amp;&amp; pvStr1 &amp;&amp; pvStr2">
          <expression>"Cobra "+pvStr0+" "+pvStr1+" "+pvStr2</expression>
        </exp>
        <pv_name>$(P)$(Q):MODEL</pv_name>
        <pv_name>$(P)$(Q):SERIES</pv_name>
        <pv_name>$(P)$(Q):CRYOSHUTTER</pv_name>
      </rule>
    </rules>
  </widget>
