      <width>205</width>
      <background_color>
        <color red="184" green="195" blue="223">
        </color>
      </background_color>
      <transparent>false</transparent>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="comms-text" prop_id="text" out_exp="false">
          <exp bool_exp="1 &lt;= pv0 &lt; 5">
            <value>Communication Errors</value>
          </exp>
          <exp bool_exp="pv0 &lt; 1">
            <value>Communication OK</value>
          </exp>
          <pv_name>$(P)$(Q):STATUS.SEVR</pv_name>
        </rule>
      </rules>
    </widget>
