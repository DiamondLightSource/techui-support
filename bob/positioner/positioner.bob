      <widget type="action_button" version="3.0.0">
        <name>MOTOR_Display</name>
        <actions>
          <action type="open_display">
            <description>Open Display</description>
            <file>$(IOC)/pmacAxis.pvi.bob</file>
            <macros>
              <P>$(P)</P>
              <M>$(M)</M>
              <label>$(label)</label>
            </macros>
            <target>replace</target>
          </action>
        </actions>
        <text>❏</text>
        <x>175</x>
        <width>25</width>
        <height>25</height>
        <font use_class="true">
          <font family="Arial" style="REGULAR" size="14.0">
          </font>
        </font>
        <foreground_color use_class="true">
          <color red="255" green="255" blue="255">
          </color>
        </foreground_color>
        <background_color use_class="true">
          <color red="29" green="41" blue="69">
          </color>
        </background_color>
        <rules>
          <rule name="visibility" prop_id="visible" out_exp="false">
            <exp bool_exp="2&lt;=pv0&lt;5">
              <value>true</value>
            </exp>
            <exp bool_exp="pv0&lt;=1">
              <value>false</value>
            </exp>
            <exp bool_exp="pv0&gt;5">
              <value>false</value>
            </exp>
            <pv_name>$(P)$(PS):SETINPUT4.VAL</pv_name>
          </rule>
        </rules>
        <tooltip>$(actions)</tooltip>
      </widget>
