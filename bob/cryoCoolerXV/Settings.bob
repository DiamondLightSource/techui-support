          <rule name="EDM visibility" prop_id="visible" out_exp="false">
            <exp bool_exp="pv0&gt;=1.0 &amp;&amp; pv0&lt;2.0">
              <value>true</value>
            </exp>
            <exp bool_exp="true">
              <value>false</value>
            </exp>
            <pv_name>=`$(P)$(R)Pwd1_OK_STS`|`$(P)$(R)Pwd2_OK_STS`|`$(P)$(R)Pwd3_OK_STS)`?1:0</pv_name>
          </rule>
        </rules>
        <widget type="action_button" version="3.0.0">
          <name>EDM activeMessageButtonClass</name>
          <actions>
            <action type="write_pv">
              <description>Set</description>
              <pv_name>$(pv_name)</pv_name>
              <value>1</value>
            </action>
          </actions>
          <pv_name>$(P)$(R)ByPass_SP_SEND.PROC</pv_name>
          <text>Set</text>
          <x>133</x>
          <y>5</y>
          <height>45</height>
          <font>
            <font family="arial" style="BOLD" size="12.0">
            </font>
          </font>
          <foreground_color>
            <color name="Controller" red="0" green="0" blue="255">
            </color>
          </foreground_color>
          <background_color>
            <color name="Canvas" red="200" green="200" blue="200">
            </color>
          </background_color>
          <rules>
            <rule name="EDM visibility" prop_id="visible" out_exp="false">
              <exp bool_exp="pv0&gt;=1.0 &amp;&amp; pv0&lt;2.0">
                <value>false</value>
              </exp>
              <exp bool_exp="true">
                <value>true</value>
              </exp>
              <pv_name>=`$(P)$(R)ByPass_SP_MON`==`$(P)$(R)ByPass_SP`?1:0</pv_name>
            </rule>
          </rules>
        </widget>
        <widget type="textentry" version="3.0.0">
          <name>EDM activeXTextDspClass</name>
          <pv_name>$(P)$(R)ByPass_SP</pv_name>
          <x>5</x>
          <y>30</y>
          <width>120</width>
          <font>
            <font family="arial" style="REGULAR" size="14.0">
            </font>
          </font>
          <foreground_color>
            <color name="Controller" red="0" green="0" blue="255">
            </color>
          </foreground_color>
          <background_color>
            <color name="grey-7" red="145" green="145" blue="145">
            </color>
          </background_color>
          <show_units>false</show_units>
        </widget>
      </widget>
      <widget type="textupdate" version="2.0.0">
        <name>EDM activeXTextDspClass:noedit</name>
        <pv_name>$(P)$(R)ByPass_SP_MON</pv_name>
        <x>5</x>
        <y>5</y>
        <width>120</width>
        <font>
          <font family="arial" style="REGULAR" size="14.0">
          </font>
        </font>
        <foreground_color>
          <color name="Monitor: NORMAL" red="0" green="224" blue="0">
          </color>
        </foreground_color>
        <background_color>
          <color name="Monitor BG" red="105" green="105" blue="105">
          </color>
        </background_color>
        <precision>0</precision>
        <show_units>false</show_units>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
      </widget>
    </widget>
    <widget type="label" version="2.0.0">
      <name>EDM activeXTextClass</name>
      <text>V10 Bypass (%) 



Buffer TopUp Day
(0-8)[0=Off,1Mon-
7Sun,8=Daily]

Buffer TopUp Hr
(0-23)</text>
      <x>5</x>
      <y>7</y>
      <width>105</width>
      <height>130</height>
      <font>
        <font family="arial" style="REGULAR" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color name="Black" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <background_color>
        <color name="Disconn/Invalid" red="255" green="255" blue="255">
        </color>
      </background_color>
      <auto_size>true</auto_size>
    </widget>
  </widget>
  <widget type="label" version="2.0.0">
    <name>EDM activeXTextClass</name>
    <text>Identity: $(P)</text>
    <x>103</x>
    <y>812</y>
    <width>1128</width>
    <height>30</height>
    <font>
      <font family="arial" style="BOLD" size="24.0">
      </font>
    </font>
    <foreground_color>
      <color name="Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="Disconn/Invalid" red="255" green="255" blue="255">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
</display>
