  <widget type="group" version="3.0.0">
    <name>Message Box</name>
    <class>LINE_BOX</class>
    <x>140</x>
    <y>840</y>
    <width>1045</width>
    <height>70</height>
    <style use_class="true">2</style>
    <font use_class="true">
      <font family="Arial" style="REGULAR" size="15.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color red="29" green="41" blue="69">
      </color>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
    <transparent>true</transparent>
    <rules>
      <rule name="Visibility" prop_id="visible" out_exp="false">
        <exp bool_exp="(pv0&gt;=128 &amp;&amp; pv0&lt;129) || (pv0&gt;=64 &amp;&amp; pv0&lt;65) || (pv0&gt;=4 &amp;&amp; pv0&lt;5) || (pv0&gt;=16 &amp;&amp; pv0&lt;17) || (pv0&gt;=8 &amp;&amp; pv0&lt;9) || (pv0&gt;=32 &amp;&amp; pv0&lt;34)">
          <value>true</value>
        </exp>
        <exp bool_exp="true">
          <value>false</value>
        </exp>
        <pv_name>$(P)$(R)Mode_STS</pv_name>
      </rule>
    </rules>
    <widget type="label" version="2.0.0">
      <name>Message</name>
      <class>CENTRAL</class>
      <text></text>
      <x>5</x>
      <y>5</y>
      <width>1034</width>
      <height>59</height>
      <font>
        <font family="Arial" style="REGULAR" size="14.0">
        </font>
      </font>
      <foreground_color>
        <color red="29" green="41" blue="69">
        </color>
      </foreground_color>
      <horizontal_alignment use_class="true">1</horizontal_alignment>
      <vertical_alignment use_class="true">1</vertical_alignment>
      <rules>
        <rule name="Message text" prop_id="text" out_exp="false">
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=7 &amp;&amp; pv1&lt;8">
            <value>Fill Load, Open V1 &amp; V2 &amp; V5 AND Close V10</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=8 &amp;&amp; pv1&lt;9">
            <value>Top Up L2 &gt; 75%, Open V3 &amp; V6</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=9 &amp;&amp; pv1&lt;10">
            <value>Close V6, Wait For T1 &lt; 80K AND T2 &lt; 100K</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=10 &amp;&amp; pv1&lt;11">
            <value>Top Up L2 &gt; 75%, Open V3 &amp; V6 AND Close V5</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=11 &amp;&amp; pv1&lt;12">
            <value>When T1&lt;79, T2&lt;85 AND P2 &amp; F1/F2 Stable (10 min) Go To Run Mode</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=2 &amp;&amp; pv1&lt;3">
            <value>Maintaining Run Conditions, Set Bypass V10 As Required.</value>
          </exp>
          <exp bool_exp="pv0&gt;=64 &amp;&amp; pv0&lt;65 &amp;&amp; pv1&gt;=3 &amp;&amp; pv1&lt;4">
            <value>Top Up Buffer L2 &gt; 80%. Open V6 Slowly To Reduce Pressure, Then Open V3</value>
          </exp>
          <exp bool_exp="pv0&gt;=4 &amp;&amp; pv0&lt;5 &amp;&amp; pv1&gt;=2 &amp;&amp; pv1&lt;3">
            <value>System Warm.</value>
          </exp>
          <exp bool_exp="pv0&gt;=16 &amp;&amp; pv0&lt;17 &amp;&amp; pv1&gt;=3 &amp;&amp; pv1&lt;4">
            <value>Close V3 &amp; V6. Wait For T10 &lt; 90K AND L1 &gt; 25%</value>
          </exp>
          <exp bool_exp="pv0&gt;=16 &amp;&amp; pv0&lt;17 &amp;&amp; pv1&gt;=4 &amp;&amp; pv1&lt;5">
            <value>Open V6 To Reduce P2 &lt; 3000mbarg</value>
          </exp>
          <exp bool_exp="pv0&gt;=16 &amp;&amp; pv0&lt;17 &amp;&amp; pv1&gt;=5 &amp;&amp; pv1&lt;6">
            <value>Open V3 &amp; V6. Top Up L2 &gt; 50%</value>
          </exp>
          <exp bool_exp="pv0&gt;=16 &amp;&amp; pv0&lt;17 &amp;&amp; pv1&gt;=6 &amp;&amp; pv1&lt;7">
            <value>Close V3 &amp; V6. Cryocooler Cold.</value>
          </exp>
          <exp bool_exp="pv0&gt;=16 &amp;&amp; pv0&lt;17 &amp;&amp; pv1&gt;=2 &amp;&amp; pv1&lt;3">
            <value>Open V3, V5 &amp; V6, Wait For L2 &gt; 50%</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=9 &amp;&amp; pv1&lt;11">
            <value>Pump &amp; Flush Complete. Close N2 Gas Valve, Close V8 and Turn Off Pump. Press STOP</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=7 &amp;&amp; pv1&lt;8">
            <value>Purge V6 For 2 Minutes</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=6 &amp;&amp; pv1&lt;7">
            <value>Purge V5 For 2 Minutes</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=5 &amp;&amp; pv1&lt;6">
            <value>Purging V4 For 2 Minutes</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=4 &amp;&amp; pv1&lt;5">
            <value>N2 Gas Flush, P2 &gt; 1000mbarg. Close Pump Valve AND Open N2 Gas Valve</value>
          </exp>
          <exp bool_exp="pv0&gt;=8 &amp;&amp; pv0&lt;9 &amp;&amp; pv1&gt;=3 &amp;&amp; pv1&lt;4">
            <value>Pump To P2 = 0, F2 = 0 AND 5 Minutes. Close N2 Gas Valve AND Open Pump Valve</value>
          </exp>
          <exp bool_exp="pv0&gt;=32 &amp;&amp; pv0&lt;34 &amp;&amp; pv1&gt;=2 &amp;&amp; pv1&lt;3">
            <value>Keep Cryocooler Cold, Close V3 &amp; V6.</value>
          </exp>
          <exp bool_exp="true">
            <value></value>
          </exp>
          <pv_name>$(P)$(R)Mode_STS</pv_name>
          <pv_name>$(P)$(R)Step_STS</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>
