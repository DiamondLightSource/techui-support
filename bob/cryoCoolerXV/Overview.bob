  <widget type="action_button" version="3.0.0">
    <name>EDM activeMessageButtonClass</name>
    <class>LINE_BOX</class>
    <actions>
      <action type="write_pv">
        <description>Buffer Top Up</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>Abort</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)ForceTopUp_CMD</pv_name>
    <text>Abort</text>
    <x>900</x>
    <y>780</y>
    <width>150</width>
    <height>45</height>
    <font>
      <font family="Arial" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="29" green="41" blue="69">
      </color>
    </background_color>
    <rules>
      <rule name="EDM visibility" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0&gt;=1.0 &amp;&amp; pv0&lt;2.0">
          <value>true</value>
        </exp>
        <exp bool_exp="true">
          <value>false</value>
        </exp>
        <pv_name>=`$(P)$(R)ButtonsVis_STS`&amp;4?1:0</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>EDM activeMessageButtonClass</name>
    <class>LINE_BOX</class>
    <actions>
      <action type="write_pv">
        <description>OK</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)OK_CMD</pv_name>
    <text>OK</text>
    <x>745</x>
    <y>780</y>
    <width>150</width>
    <height>45</height>
    <font>
      <font family="Arial" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="29" green="41" blue="69">
      </color>
    </background_color>
    <rules>
      <rule name="EDM visibility" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0&gt;=1.0 &amp;&amp; pv0&lt;2.0">
          <value>true</value>
        </exp>
        <exp bool_exp="true">
          <value>false</value>
        </exp>
        <pv_name>=`$(P)$(R)ButtonsVis_STS`&amp;64?1:0</pv_name>
      </rule>
    </rules>
  </widget>
</display>
