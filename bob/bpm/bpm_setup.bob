        </color>
      </foreground_color>
      <horizontal_alignment use_class="true">1</horizontal_alignment>
      <vertical_alignment use_class="true">1</vertical_alignment>
      <rules>
        <rule name="orientation-change" prop_id="text" out_exp="false">
          <exp bool_exp="pv0 == 1">
            <value>X = KX*((A-DA)-(B-DB)-(C-DC)+(D-DD))/I =</value>
          </exp>
          <pv_name>$(bpm):ORIENT</pv_name>
        </rule>
      </rules>
    </widget>
