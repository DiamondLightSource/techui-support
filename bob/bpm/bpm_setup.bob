    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_24</name>
      <class>CENTRAL</class>
      <text>X = KX*((D-DD)-(B-DB))/((D-DD)+(B-DB)) =</text>
      <y>25</y>
      <width>290</width>
