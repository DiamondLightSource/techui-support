    <widget type="label" version="2.0.0">
      <name>Label_23</name>
      <class>CENTRAL</class>
      <text>I = (A-DA)+(B-DB)+(C-DC)+(D-DD) =</text>
      <width>290</width>
      <font>
        <font family="Arial" style="REGULAR" size="14.0">
        </font>
      </font>
