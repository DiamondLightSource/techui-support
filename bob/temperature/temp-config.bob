<display version="2.0.0">
  <name>Temp Config</name>
  <y>0</y>
  <width>315</width>
  <height>370</height>
  <background_color>
    <color red="245" green="247" blue="250">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>Not Title</class>
    <text>$(temp)</text>
    <width>310</width>
    <height>40</height>
    <font>
      <font family="Arial" style="BOLD" size="32.0">
      </font>
    </font>
    <foreground_color>
      <color red="29" green="41" blue="69">
      </color>
    </foreground_color>
    <background_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>$(temp).DESC</text>
    <x>110</x>
    <y>40</y>
    <font>
      <font family="Cantarell" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>0</vertical_alignment>
    <rotation_step>0</rotation_step>
    <wrap_words>true</wrap_words>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>Current Temp:</text>
    <x>5</x>
    <y>225</y>
    <height>25</height>
    <font>
      <font family="Cantarell" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>0</vertical_alignment>
    <rotation_step>0</rotation_step>
    <wrap_words>true</wrap_words>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <class>Not Default</class>
    <x>5</x>
    <y>60</y>
    <height>151</height>
    <style>2</style>
    <font>
      <font family="Arial" style="REGULAR" size="15.0">
      </font>
    </font>
    <foreground_color>
      <color red="29" green="41" blue="69">
      </color>
    </foreground_color>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
    <transparent>true</transparent>
    <widget type="meter" version="3.0.0">
      <name>Meter</name>
      <pv_name>$(temp)</pv_name>
      <width>299</width>
      <height>149</height>
    </widget>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(temp)</pv_name>
    <x>105</x>
    <y>225</y>
    <width>90</width>
    <height>25</height>
    <font>
      <font family="Cantarell" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="15" green="23" blue="42">
      </color>
    </foreground_color>
    <background_color>
      <color red="245" green="247" blue="250">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <border_color>
      <color red="203" green="213" blue="225">
      </color>
    </border_color>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <text>Interlocks</text>
