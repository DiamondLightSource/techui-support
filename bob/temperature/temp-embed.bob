<?xml version="1.0" encoding="UTF-8"?>
<!--Saved on 2026-01-21 14:22:11 by ryi58813-->
<display version="2.0.0">
  <name>Temp Embed</name>
  <y>0</y>
  <width>100</width>
  <height>20</height>
  <background_color>
    <color red="245" green="247" blue="250">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Temp Config</description>
        <file>temp-config.bob</file>
        <macros>
          <temp>$(temp)</temp>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>$(label)</text>
    <width>20</width>
    <height>20</height>
    <font>
      <font family="Cantarell" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="37" green="99" blue="235">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(temp)</pv_name>
    <x>20</x>
    <width>55</width>
    <font>
      <font family="Cantarell" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="15" green="23" blue="42">
      </color>
    </foreground_color>
    <background_color>
      <color red="245" green="247" blue="250">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <border_color>
      <color red="203" green="213" blue="225">
      </color>
    </border_color>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>$(temp).SEVR</pv_name>
    <x>75</x>
    <off_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </off_color>
    <on_color>
      <color name="Write_Background" red="128" green="255" blue="255">
      </color>
    </on_color>
    <font>
      <font family="Cantarell" style="BOLD" size="12.0">
      </font>
    </font>
  </widget>
</display>
